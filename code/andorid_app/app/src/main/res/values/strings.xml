  <string name="title_deformaciones">Deformaciones y desprendimiento</string>
  <string name="title_roturas">Roturas</string>
  <string name="title_otras">Otras incidencias</string>


  <string name="item_hundimiento">Hundimiento</string>
  <string name="desc_hundimiento">Depresión o bajada localizada en el pavimento, causada por asentamientos o falta de soporte.</string>

  <string name="item_blandones">Blandones</string>
  <string name="desc_blandones">Áreas blandas en el pavimento que pueden hundirse bajo carga debido a fallos en la base o subrasante.</string>

  <string name="item_firme_ondulado">Firme ondulado</string>
  <string name="desc_firme_ondulado">Ondulaciones visibles en la superficie del pavimento, que afectan la comodidad de la conducción.</string>

  <string name="item_protuberancias">Protuberancias</string>
  <string name="desc_protuberancias">Elevaciones puntuales en el pavimento, a menudo causadas por raíces o deformaciones internas.</string>

  <string name="item_escalonamiento">Escalonamiento</string>
  <string name="desc_escalonamiento">Diferencia de nivel entre dos superficies adyacentes, generalmente en juntas o reparaciones.</string>

  <string name="item_agujero">Agujero</string>
  <string name="desc_agujero">Hueco o cavidad formada en el pavimento debido a desprendimiento o desgaste severo.</string>

  <string name="item_grieta_longitudinal">Grieta longitudinal</string>
  <string name="desc_grieta_longitudinal">Fisura que corre paralela al eje de la carretera, causada por tensiones internas o deformaciones.</string>

  <string name="item_grieta_longitud_junta">Grieta longitudinal en junta de construcción</string>
  <string name="desc_grieta_longitud_junta">Fisura que aparece a lo largo de la junta donde se unen dos pavimentos construidos en diferentes tiempos.</string>

  <string name="item_grieta_transversal">Grieta transversal</string>
  <string name="desc_grieta_transversal">Fisura perpendicular al eje de la carretera, provocada por movimientos térmicos o asentamientos diferenciales.</string>

  <string name="item_grieta_cocodrilo">Piel de cocodrilo</string>
  <string name="desc_grieta_cocodrilo">Conjunto de grietas interconectadas que forman un patrón similar a la piel de un cocodrilo. Generalmente indica una fatiga estructural en capas inferiores del pavimento.</string>

  <string name="item_grieta_longitud_fisura">Grieta longitudinal en fisura longitudinal</string>
  <string name="desc_grieta_longitud_fisura">Fisura longitudinal secundaria que se desarrolla dentro de una fisura principal.</string>


  <string name="item_alcantarillas">Alcantarillas</string>
  <string name="desc_alcantarillas">Estructuras para drenaje de aguas pluviales que pueden presentar daños o bloqueos.</string>

  <string name="item_senalizacion">Señalización horizontal deteriorada</string>
  <string name="desc_senalizacion">Desgaste o desaparición de marcas viales en el pavimento que afectan la seguridad vial.</string>

  <string name="title_help">Ayuda</string>
  <string name="desc_help">Esta sección tiene como objetivo ayudarte a identificar correctamente el tipo de incidencia. Dado que el modelo de inteligencia artificial aún está en fase beta y puede no ser completamente preciso, te recomendamos que selecciones manualmente el tipo de incidencia si estás seguro de cuál es. A continuación, te mostramos ejemplos de las incidencias que puedes encontrar.</string>


</resources>
